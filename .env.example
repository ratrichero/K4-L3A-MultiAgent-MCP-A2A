COMPETITION_API_URL=https://n7-competition.pages.dev
COMPETITION_TEAM_API_KEY=sk-team-replace_me
MCP_ENDPOINT=https://day09-competition.34-142-201-239.sslip.io/mcp

# --- LLM Providers & Multi-Tier Fallback Configuration (<= 10B Parameters Limit) ---
# Google Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI / OpenAI-compatible API Key (OpenAI, Groq, OpenRouter, Together, or local vLLM/Ollama)
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom OpenAI-compatible Base URL (e.g., https://api.groq.com/openai/v1 or http://localhost:11434/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tier 0 (Primary Model): Gemini 2.5 Flash-Lite (Google lightweight model)
PRIMARY_MODEL=gemini-2.5-flash-lite

# Tier 1 (Fallback Model 1): Gemma 2 9B (Official 9B parameter model) or Llama 3.1 8B
FALLBACK_MODEL_1=gemma-2-9b-it

# Tier 2 (Fallback Model 2): Qwen 2.5 7B or Llama 3.2 3B
FALLBACK_MODEL_2=qwen2.5-7b-instruct

# LLM Runtime Settings
LLM_TIMEOUT=60.0
LLM_TEMPERATURE=0.1